---
/**
 * Editorial section heading: a display-size <h2> with an optional lede.
 *
 * The heading level is fixed at <h2> so the page keeps a valid outline under
 * the single hero <h1>.
 *
 * Nothing here pins. Section titles used to render inside a sticky bar under
 * the nav; the floating pill now carries the "where am I" job on its own (the
 * link for the section in view is marked `aria-current` — see
 * scripts/navHighlight.ts), so the heading is free to scroll away with its
 * content.
 *
 * Carries `data-animate="section-heading"`. initSectionHeadings in
 * scripts/animations.ts reads the hook as "the <h2> inside it, if any, plus
 * whatever else it holds", so the title gets the word stagger and the lede the
 * supporting reveal.
 */
interface Props {
  title: string;
  /** Optional one-line lede under the title. */
  lede?: string;
}

const { title, lede } = Astro.props;
---

<div data-animate="section-heading" class="max-w-3xl">
  <h2 class="display-md text-text">{title}</h2>
  {lede && <p class="mt-4 text-base text-muted sm:text-lg">{lede}</p>}
</div>
