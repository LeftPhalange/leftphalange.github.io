---
/**
 * GitHub mark, drawn in the Lucide idiom.
 *
 * Lucide removed its brand icons in v1, so this is kept locally rather than
 * imported. The geometry is Lucide's own retired `github` node (ISC, same
 * licence as the package), so it sits on the same 24-unit grid with the same
 * stroke weight as the real Lucide icons beside it — an outline mark, not a
 * solid brand glyph, which is what keeps the hero row visually uniform.
 *
 * Monochrome by construction: the stroke is `currentColor`, so the icon takes
 * whatever colour its link is in and follows the hover/focus transition for
 * free.
 */
import type { IconProps as Props } from '@lucide/astro';

const { size = 24, class: className, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['lucide', className]}
  {...rest}
>
  <path
    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
  ></path>
  <path d="M9 18c-4.51 2-5-2-7-2"></path>
</svg>
