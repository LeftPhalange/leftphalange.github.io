---
/**
 * Renders the icon for one of the site's primary links.
 *
 * The `name` is a plain string on the link data (see data/site.ts) rather than
 * a component reference, which keeps that module free of any component import
 * — it stays pure data. This file is the one place the mapping lives, so the
 * hero and the footer can't drift apart on which mark belongs to which link.
 *
 * Every icon here is a stroked outline on the same 24-unit grid, coloured by
 * `currentColor`. Nothing sets a colour of its own: the caller decides, which
 * is what lets a link tint its label and its icon together on hover.
 */
import FileTextIcon from '@lucide/astro/icons/file-text';
import MailIcon from '@lucide/astro/icons/mail';
import type { LinkIconName } from '../../data/site.ts';
import GithubIcon from './GithubIcon.astro';
import LinkedInIcon from './LinkedInIcon.astro';

interface Props {
  name: LinkIconName;
  /** Intrinsic px size. Class-based sizing overrides it; this is the fallback. */
  size?: number;
  class?: string;
}

const icons = {
  linkedin: LinkedInIcon,
  github: GithubIcon,
  resume: FileTextIcon,
  email: MailIcon,
} as const;

const { name, size = 18, class: className } = Astro.props;

const Icon = icons[name];
---

<Icon size={size} class={className} />
