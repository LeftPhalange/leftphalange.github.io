---
/**
 * LinkedIn mark, drawn in the Lucide idiom.
 *
 * Same reasoning as GithubIcon.astro: Lucide dropped brand icons in v1, and
 * the usual replacement (a solid Simple Icons glyph) would read far heavier
 * than the stroked mail/document icons next to it. This is Lucide's retired
 * `linkedin` node, so weight and grid match exactly.
 *
 * Monochrome by construction — stroke is `currentColor`.
 */
import type { IconProps as Props } from '@lucide/astro';

const { size = 24, class: className, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={['lucide', className]}
  {...rest}
>
  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
  ></path>
  <rect width="4" height="12" x="2" y="9"></rect>
  <circle cx="4" cy="4" r="2"></circle>
</svg>
